{
  "name": "payments-platform",
  "version": "0.1.0",
  "private": true,
  "description": "US Payments Curriculum: the platform built across Projects 1 to 5.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "ts-node src/main.ts",
    "test": "jest --config jest.config.js",
    "test:typecheck": "tsc -p test/tsconfig.json",
    "test:hidden": "jest --config jest.hidden.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.15",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prettier": "3.9.10",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  }
}
